{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build SummerSchool slides",
      "type": "process",
      "command": "tectonic",
      "args": [
        "--synctex",
        "--keep-logs",
        "--outdir",
        "${workspaceFolder}/Slides",
        "${workspaceFolder}/Slides/main.tex"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
